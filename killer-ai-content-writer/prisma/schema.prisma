// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantFact {
  id        String   @id @default(cuid())
  shop      String
  productId String
  question  String
  answer    String
  unknown   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shop, productId, question])
  @@index([shop, productId])
}

model Article {
  id        String   @id @default(cuid())
  shop      String
  productId String
  angle     String
  state     String   @default("writing")
  stage     String   @default("Starting")
  result    String?
  error     String?
  keyword   String? // the search phrase this article targets, kept so later articles don't compete for it
  title     String? // the working title of the topic
  sentAs    String? // "draft" or "live" once sent to the blog
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, productId])
  @@index([shop, keyword])
}

model ProductAngles {
  shop      String
  productId String
  angles    String
  chosen    String?
  updatedAt DateTime @updatedAt

  @@id([shop, productId])
}

model ShopSettings {
  shop      String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  shop      String
  kind      String // "message" or "thumb"
  rating    Int? // 1 = helpful, -1 = not helpful
  message   String?
  context   String? // where it came from, for example "help:getting-started" or "article:<id>"
  createdAt DateTime @default(now())

  @@index([shop])
}

model Author {
  id         String   @id @default(cuid())
  shop       String
  kind       String   @default("real") // "real" (an actual person) or "persona" (an invented author)
  name       String
  jobTitle   String   @default("")
  bio        String   @default("")
  profileUrl String   @default("")
  photoUrl   String   @default("")
  photoAlt   String   @default("")
  voice      String   @default("") // optional writing-style notes for this author
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop])
}

model ScheduledPost {
  id           String   @id @default(cuid())
  shop         String
  productId    String // numeric product id
  productTitle String   @default("")
  angle        String // the chosen topic (JSON)
  publishAt    DateTime
  authorId     String   @default("")
  imageUrl     String   @default("")
  imageAlt     String   @default("")
  status       String   @default("scheduled") // scheduled | writing | sent | failed
  articleId    String?
  note         String? // a failure reason, or a note such as "saved as a draft for review"
  notified     Boolean  @default(false) // included in an upcoming-topics email
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, publishAt])
}

model ScheduleStatus {
  shop      String   @id
  note      String   @default("") // why the schedule couldn't be filled, shown to the merchant
  working   Boolean  @default(false) // topics are still being found in the background
  updatedAt DateTime @updatedAt
}

/// A merchant's decision on a sentence the fact-check flagged: kept as an audit record, and accepted sentences are remembered so they are not flagged again.
model SentenceReview {
  id        String   @id @default(cuid())
  shop      String
  articleId String
  sentence  String
  key       String // the sentence in lower case without punctuation, for matching later articles
  problem   String
  decision  String // "accepted" (this is correct) or "ignored"
  note      String   @default("")
  decidedBy String   @default("")
  createdAt DateTime @default(now())

  @@index([shop, articleId])
  @@index([shop, decision, key])
}

/// One update of a blog post made by AI Refresh. The old and new text are kept for 30 days so the update can be undone.
model RefreshRun {
  id           String          @id @default(cuid())
  shop         String
  articleId    String // Shopify article id (gid)
  articleTitle String
  handle       String          @default("")
  bodyBefore   String? // cleared after 30 days
  bodyAfter    String? // as Shopify saved it; cleared after 30 days
  wordsBefore  Int
  wordsAfter   Int
  seoBefore    Int
  seoAfter     Int
  aiBefore     Int
  aiAfter      Int
  appliedBy    String          @default("")
  appliedAt    DateTime        @default(now())
  undoneAt     DateTime?
  changes      RefreshChange[]

  @@index([shop, articleId])
  @@index([appliedAt])
}

/// Every change AI Refresh proposed in a run and what the merchant decided: the audit trail.
model RefreshChange {
  id        String     @id @default(cuid())
  runId     String
  run       RefreshRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  shop      String
  articleId String
  rule      String
  kind      String // "remove_link"
  before    String
  after     String
  detail    String     @default("")
  decision  String // "accepted" or "ignored"
  createdAt DateTime   @default(now())

  @@index([shop, articleId])
  @@index([runId])
}

/// Posts (or whole blogs) the merchant never wants AI Refresh to touch.
model RefreshProtected {
  id        String   @id @default(cuid())
  shop      String
  kind      String // "post" or "blog"
  ref       String // numeric article id, or blog handle
  label     String   @default("")
  createdAt DateTime @default(now())

  @@unique([shop, kind, ref])
}
