// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantFact {
  id        String   @id @default(cuid())
  shop      String
  productId String
  question  String
  answer    String
  unknown   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shop, productId, question])
  @@index([shop, productId])
}

model Article {
  id        String   @id @default(cuid())
  shop      String
  productId String
  angle     String
  state     String   @default("writing")
  stage     String   @default("Starting")
  result    String?
  error     String?
  keyword   String? // the search phrase this article targets, kept so later articles don't compete for it
  title     String? // the working title of the topic
  sentAs    String? // "draft" or "live" once sent to the blog
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, productId])
  @@index([shop, keyword])
}

model ProductAngles {
  shop      String
  productId String
  angles    String
  chosen    String?
  updatedAt DateTime @updatedAt

  @@id([shop, productId])
}

model ShopSettings {
  shop      String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  shop      String
  kind      String // "message" or "thumb"
  rating    Int? // 1 = helpful, -1 = not helpful
  message   String?
  context   String? // where it came from, for example "help:getting-started" or "article:<id>"
  createdAt DateTime @default(now())

  @@index([shop])
}

model Author {
  id         String   @id @default(cuid())
  shop       String
  kind       String   @default("real") // "real" (an actual person) or "persona" (an invented author)
  name       String
  jobTitle   String   @default("")
  bio        String   @default("")
  profileUrl String   @default("")
  photoUrl   String   @default("")
  photoAlt   String   @default("")
  voice      String   @default("") // optional writing-style notes for this author
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop])
}

model ScheduledPost {
  id           String   @id @default(cuid())
  shop         String
  productId    String // numeric product id
  productTitle String   @default("")
  angle        String // the chosen topic (JSON)
  publishAt    DateTime
  authorId     String   @default("")
  imageUrl     String   @default("")
  imageAlt     String   @default("")
  status       String   @default("scheduled") // scheduled | writing | sent | failed
  articleId    String?
  note         String? // a failure reason, or a note such as "saved as a draft for review"
  notified     Boolean  @default(false) // included in an upcoming-topics email
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, publishAt])
}
